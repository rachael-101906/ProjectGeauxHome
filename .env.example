# Copy to .env.local and fill in. .env.local is git-ignored — never commit your key.
# Server-side only (no VITE_ prefix), used by the /api/tts proxy in vite.config.js:
ELEVENLABS_API_KEY=

# Voice IDs are not secret. Find them in ElevenLabs > Voices > (voice) > ID.
VITE_ELEVENLABS_VOICE_ROVER=
VITE_ELEVENLABS_VOICE_HUGH=
# Optional trader voices (fall back to the default voice if blank):
VITE_ELEVENLABS_VOICE_MARTY=
VITE_ELEVENLABS_VOICE_DJ=
VITE_ELEVENLABS_VOICE_OXY=
